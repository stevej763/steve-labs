DATABASE_URL=jdbc:postgresql://localhost:5432/steves_lab
DATABASE_USERNAME=steves_lab
DATABASE_PASSWORD=steves_lab
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=steves-lab-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Docker builds embed this in public browser JavaScript. Rebuild web/admin after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Canonical URL and sitemap base. Rebuild web after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side Next.js request target. Compose supplies http://api:8080 automatically.
INTERNAL_API_URL=http://api:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Server example: override the values above with production database/S3 secrets and:
# NEXT_PUBLIC_API_BASE_URL=https://blog-api.steve-labs.uk
# S3_PUBLIC_ENDPOINT=https://blog-api.steve-labs.uk
# CORS_ALLOWED_ORIGINS=https://blog.steve-labs.uk,https://admin.blog.steve-labs.uk